<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/amnezia_midnight"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <FrameLayout
        android:id="@+id/contentContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ScrollView
            android:id="@+id/mainScroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
                android:paddingTop="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="28dp">

            <TextView
                android:id="@+id/appTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textColor="@color/amnezia_pale"
                android:textSize="32sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/appSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="SSH-туннель с быстрым переключением серверов"
                android:textColor="@color/amnezia_muted"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:gravity="center"
                android:text="Отключено"
                android:textColor="@color/amnezia_muted"
                android:textSize="16sp" />

            <Button
                android:id="@+id/toggle"
                android:layout_width="190dp"
                android:layout_height="190dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="16dp"
                android:background="@drawable/connect_button_background"
                android:gravity="center"
                android:padding="20dp"
                android:text="Подключить"
                android:textColor="@color/amnezia_pale"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/speedPing"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:text="Скорость: 0 Б/с · Пинг: —"
                android:textColor="@color/amnezia_muted"
                android:textSize="15sp" />

            <LinearLayout
                android:id="@+id/debugPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/debug_panel_background"
                android:orientation="vertical"
                android:padding="16dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:text="HUYNA DEBUG"
                    android:textColor="#FF2DAA"
                    android:textSize="19sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/debugInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="monospace"
                    android:text="SERVICE  OFFLINE"
                    android:textColor="@color/amnezia_pale"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:background="@drawable/panel_background"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Куда направлять трафик"
                    android:textColor="@color/amnezia_pale"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <CheckBox
                    android:id="@+id/enableVpn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="VPN для всего телефона"
                    android:textColor="@color/amnezia_pale"
                    android:textSize="16sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="34dp"
                    android:text="Браузер и остальные приложения пойдут через выбранный сервер."
                    android:textColor="@color/amnezia_muted"
                    android:textSize="13sp" />

                <CheckBox
                    android:id="@+id/enableTelegram"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:checked="true"
                    android:text="Локальный прокси для Telegram"
                    android:textColor="@color/amnezia_pale"
                    android:textSize="16sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="34dp"
                    android:text="Можно включить вместе с VPN или использовать отдельно."
                    android:textColor="@color/amnezia_muted"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/splitTunnelButton"
                    style="@style/Widget.Pelmeni.Button.Secondary"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="14dp"
                    android:text="Раздельное туннелирование" />

                <TextView
                    android:id="@+id/splitTunnelSummary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:paddingTop="4dp"
                    android:text="Выключено · весь трафик через VPN"
                    android:textColor="@color/amnezia_muted"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Активный сервер"
                android:textColor="@color/amnezia_pale"
                android:textSize="20sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/serverProfileCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/panel_background"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:id="@+id/serverName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Сервер не добавлен"
                    android:textColor="@color/amnezia_pale"
                    android:textSize="25sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/serverAddress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="Добавь первый сервер"
                    android:textColor="@color/amnezia_muted"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Нажми «Выбрать», чтобы быстро переключиться. Параметры и TLS хранятся отдельно для каждого сервера."
                    android:textColor="@color/amnezia_muted"
                    android:textSize="12sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/serverSelect"
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_weight="1"
                        android:text="Выбрать" />

                    <Button
                        android:id="@+id/serverEdit"
                        style="@style/Widget.Pelmeni.Button.Secondary"
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:text="Параметры" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/panel_background"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Трафик"
                    android:textColor="@color/amnezia_pale"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="За сессию"
                    android:textColor="@color/amnezia_muted"
                    android:textSize="13sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="Загружено"
                        android:src="@drawable/ic_download" />

                    <TextView
                        android:id="@+id/sessionDown"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:text="0 Б"
                        android:textColor="@color/amnezia_pale"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="Отправлено"
                        android:src="@drawable/ic_upload" />

                    <TextView
                        android:id="@+id/sessionUp"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:text="0 Б"
                        android:textColor="@color/amnezia_pale"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="13dp"
                    android:layout_marginBottom="11dp"
                    android:background="@color/amnezia_slate" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="За всё время"
                    android:textColor="@color/amnezia_muted"
                    android:textSize="13sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="Загружено всего"
                        android:src="@drawable/ic_download" />

                    <TextView
                        android:id="@+id/totalDown"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:text="0 Б"
                        android:textColor="@color/amnezia_pale"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="Отправлено всего"
                        android:src="@drawable/ic_upload" />

                    <TextView
                        android:id="@+id/totalUp"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:text="0 Б"
                        android:textColor="@color/amnezia_pale"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <EditText
                android:id="@+id/host"
                android:layout_width="1dp"
                android:layout_height="1dp"
                android:visibility="gone" />
            <EditText
                android:id="@+id/port"
                android:layout_width="1dp"
                android:layout_height="1dp"
                android:visibility="gone" />
            <EditText
                android:id="@+id/socksPort"
                android:layout_width="1dp"
                android:layout_height="1dp"
                android:visibility="gone" />
            <EditText
                android:id="@+id/user"
                android:layout_width="1dp"
                android:layout_height="1dp"
                android:visibility="gone" />
            <EditText
                android:id="@+id/password"
                android:layout_width="1dp"
                android:layout_height="1dp"
                android:visibility="gone" />
            <CheckBox
                android:id="@+id/showPassword"
                android:layout_width="1dp"
                android:layout_height="1dp"
                android:visibility="gone" />
            <CheckBox
                android:id="@+id/autoReconnect"
                android:layout_width="1dp"
                android:layout_height="1dp"
                android:visibility="gone" />
            <CheckBox
                android:id="@+id/startOnBoot"
                android:layout_width="1dp"
                android:layout_height="1dp"
                android:visibility="gone" />
            <Button
                android:id="@+id/save"
                android:layout_width="1dp"
                android:layout_height="1dp"
                android:visibility="gone" />
        </LinearLayout>
        </ScrollView>
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:background="@drawable/bottom_bar_background"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <LinearLayout
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="Главная"
                android:src="@drawable/ic_nav_home"
                android:tint="@color/amnezia_accent" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Главная"
                android:textColor="@color/amnezia_accent"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navSettings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="Настройки"
                android:src="@drawable/ic_nav_settings"
                android:tint="@color/amnezia_muted" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Настройки"
                android:textColor="@color/amnezia_muted"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navAdd"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="Добавить сервер"
                android:src="@drawable/ic_nav_add"
                android:tint="@color/amnezia_muted" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Сервер"
                android:textColor="@color/amnezia_muted"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
