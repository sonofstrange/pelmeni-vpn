<resources>
<style name="Theme.SshTunnel" parent="android:style/Theme.Material.NoActionBar">
    <item name="android:fontFamily">sans-serif</item>
    <item name="android:buttonStyle">@style/Widget.Pelmeni.Button</item>
    <item name="android:alertDialogTheme">@style/Theme.Pelmeni.Dialog</item>
    <item name="android:colorAccent">@color/amnezia_accent</item>
    <item name="android:windowBackground">@color/amnezia_midnight</item>
    <item name="android:navigationBarColor">@color/amnezia_midnight</item>
    <item name="android:statusBarColor">@color/amnezia_midnight</item>
    <item name="android:windowLightStatusBar">false</item>
    <item name="android:textColorPrimary">@color/amnezia_pale</item>
    <item name="android:textColorSecondary">@color/amnezia_muted</item>
</style>

<style name="Widget.Pelmeni.Button" parent="@android:style/Widget.Material.Button">
    <item name="android:background">@drawable/button_primary_background</item>
    <item name="android:backgroundTint">@null</item>
    <item name="android:textColor">@color/button_primary_text</item>
    <item name="android:fontFamily">sans-serif-medium</item>
    <item name="android:textSize">16sp</item>
    <item name="android:textAllCaps">false</item>
    <item name="android:gravity">center</item>
    <item name="android:minHeight">56dp</item>
    <item name="android:minWidth">64dp</item>
    <item name="android:paddingStart">18dp</item>
    <item name="android:paddingEnd">18dp</item>
    <item name="android:elevation">0dp</item>
    <item name="android:stateListAnimator">@null</item>
</style>

<style name="Widget.Pelmeni.Button.Secondary" parent="@style/Widget.Pelmeni.Button">
    <item name="android:background">@drawable/button_secondary_background</item>
    <item name="android:textColor">@color/button_secondary_text</item>
</style>

<style name="Theme.Pelmeni.Dialog" parent="@android:style/Theme.Material.Dialog.Alert">
    <item name="android:fontFamily">sans-serif</item>
    <item name="android:windowBackground">@drawable/dialog_background</item>
    <item name="android:colorAccent">@color/amnezia_accent</item>
    <item name="android:textColorPrimary">@color/amnezia_pale</item>
    <item name="android:textColorSecondary">@color/amnezia_muted</item>
</style>
</resources>
